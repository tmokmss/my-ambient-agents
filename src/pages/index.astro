---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { FileText, Search, AlertTriangle, Flame } from "@lucide/astro";

const reports = (await getCollection("reports")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const categoryIcons: Record<string, any> = { summary: FileText, analysis: Search, alert: AlertTriangle, buzz: Flame };

// 一覧は全件を HTML に焼くと 1600 件で 3.7MB（DOM 3.6万要素）になり、
// 初回に見える 20 件以外は使われないまま転送・パースされる。
// ここでは 1ページ目だけを返し、残りのメタデータは /reports-index/*.json を
// 2ページ目以降や絞り込みが必要になった時点で取りに行く。
const PAGE_SIZE = 20;
const firstPage = reports.slice(0, PAGE_SIZE);
---

<Layout title="Reports">
  <div class="flex flex-wrap gap-3 mb-6 items-start">
    <div class="flex-1 min-w-[200px] max-sm:min-w-0">
      <input type="search" id="search-input" placeholder="全文検索..." autocomplete="off" class="w-full h-9 px-3 text-[0.8rem] border border-[var(--border)] rounded-lg bg-[var(--card-bg)] text-[var(--fg)] outline-none transition-[border-color] duration-150 focus:border-[var(--accent)] placeholder:text-[var(--muted)]" />
    </div>
    {reports.length > 0 && (
      <div class="relative min-w-[200px] flex-1 max-w-xs max-sm:min-w-0 max-sm:max-w-none" id="tag-combo">
        <div class="relative flex items-center">
          <input class="w-full h-9 pr-8 pl-3 text-[0.8rem] border border-[var(--border)] rounded-lg bg-[var(--card-bg)] text-[var(--fg)] outline-none focus:border-[var(--accent)] placeholder:text-[var(--muted)]" id="tag-input" type="text" placeholder="タグで絞り込み..." autocomplete="off" />
          <button class="tag-clear absolute right-1.5 items-center justify-center w-5 h-5 border-none rounded-full bg-[var(--muted)] text-[var(--bg)] text-[0.7rem] leading-none cursor-pointer p-0 hover:bg-[var(--fg)]" id="tag-clear" aria-label="タグをクリア">&times;</button>
        </div>
        {/*
          候補は全件のタグの集合（現状 946 個）で、HTML に焼くと 131KB になる。
          一覧メタデータから作れる内容なので、開かれた時点で JS が組み立てる。
        */}
        <ul class="tag-dropdown absolute top-full left-0 right-0 max-h-[200px] overflow-y-auto bg-[var(--card-bg)] border border-[var(--border)] border-t-0 rounded-b-lg z-10 list-none" id="tag-dropdown"></ul>
        <template id="tag-option-template">
          <li class="tag-option px-3 py-1.5 text-[0.8rem] cursor-pointer text-[var(--fg)] hover:bg-[var(--code-bg)]"></li>
        </template>
      </div>
    )}
    <div class="flex items-center gap-2 max-sm:[&_label]:hidden max-sm:[&_.date-input]:w-full">
      <label for="date-until" class="text-[0.8rem] text-[var(--muted)] whitespace-nowrap">表示期間:</label>
      <input class="date-input h-9 px-3 text-[0.8rem] font-[inherit] border border-[var(--border)] rounded-lg bg-[var(--card-bg)] text-[var(--fg)] outline-none focus:border-[var(--accent)]" id="date-until" type="date" />
    </div>
  </div>
  <div class="flex flex-wrap gap-1.5 mb-4 empty:hidden" id="selected-tags"></div>

  {reports.length === 0 ? (
    <p class="text-[var(--muted)]">No reports yet. The agent will generate the first report on its next scheduled run.</p>
  ) : (
    <>
      <p class="text-[0.8rem] text-[var(--muted)] mb-4" id="result-count">{reports.length}件中 {firstPage.length}件表示</p>
      <ul class="list-none flex flex-col gap-4" id="report-list" data-total={reports.length}>
        {firstPage.map((report) => (
          <li class="report-card px-5 py-4 bg-[var(--card-bg)] border border-[var(--border)] rounded-lg flex gap-4 items-start">
            {() => {
              const Icon = categoryIcons[report.data.category];
              return Icon ? <span class="shrink-0 text-[var(--muted)] mt-0.5 [&_svg]:w-[18px] [&_svg]:h-[18px]"><Icon size={18} /></span> : null;
            }}
            <div class="min-w-0">
              <h2 class="text-base font-semibold mb-1"><a href={`${import.meta.env.BASE_URL}/reports/${report.id}/`}>{report.data.title}</a></h2>
              <div class="text-[0.8rem] text-[var(--muted)]">
                <time class="local-time" datetime={new Date(report.data.date).toISOString()}>{new Date(new Date(report.data.date).getTime() + 9 * 60 * 60 * 1000).toISOString().slice(0, 16).replace('T', ' ')} JST</time> &middot;
                <span>{report.data.category}</span>
              </div>
              <p class="text-sm mt-2">{report.data.summary}</p>
              {(report.data.tags ?? []).length > 0 && (
                <div class="flex flex-wrap gap-1 mt-2">
                  {(report.data.tags ?? []).map((tag) => (
                    <span class="text-[0.7rem] px-2 py-0.5 rounded-full bg-[var(--code-bg)] text-[var(--muted)]">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </li>
        ))}
      </ul>
      <div class="h-10 flex items-center justify-center text-[0.8rem] text-[var(--muted)]" id="load-sentinel" style={reports.length > PAGE_SIZE ? undefined : "display:none"} aria-hidden="true">読み込み中...</div>

      {/*
        2ページ目以降と絞り込み結果を JS が組み立てるための雛形。
        class は上の SSR カードと同じものを並べてあるので、片方を変えたらもう片方も直すこと。
        中身は textContent で流し込む（レポート本文は外部フィードを元にした値なので innerHTML には渡さない）。
      */}
      <template id="card-template">
        <li class="report-card px-5 py-4 bg-[var(--card-bg)] border border-[var(--border)] rounded-lg flex gap-4 items-start">
          <span class="card-icon shrink-0 text-[var(--muted)] mt-0.5 [&_svg]:w-[18px] [&_svg]:h-[18px]"></span>
          <div class="min-w-0">
            <h2 class="text-base font-semibold mb-1"><a class="card-link" href=""></a></h2>
            <div class="text-[0.8rem] text-[var(--muted)]">
              <time class="card-time"></time> &middot;
              <span class="card-category"></span>
            </div>
            <p class="card-summary text-sm mt-2"></p>
            <div class="card-tags flex flex-wrap gap-1 mt-2"></div>
          </div>
        </li>
      </template>
      <template id="tag-template">
        <span class="text-[0.7rem] px-2 py-0.5 rounded-full bg-[var(--code-bg)] text-[var(--muted)]"></span>
      </template>
      <div hidden id="icon-templates">
        {Object.entries(categoryIcons).map(([name, Icon]) => (
          <span data-icon={name}><Icon size={18} /></span>
        ))}
      </div>
    </>
  )}

  <script>
    import { PARTS } from '../lib/report-parts';
    import { normalizeForSearch } from '../lib/search-text';

    /** /reports-index/*.json の1件。並びはエンドポイント側と対応している */
    type Entry = [
      id: string,
      title: string,
      summary: string,
      date: string,
      category: string,
      tags: string[],
    ];

    const PAGE_SIZE = 20;
    const BASE_URL = import.meta.env.BASE_URL;

    const list = document.getElementById('report-list');
    const cardTemplate = document.getElementById('card-template') as HTMLTemplateElement | null;
    const tagTemplate = document.getElementById('tag-template') as HTMLTemplateElement | null;
    const iconTemplates = document.getElementById('icon-templates');
    const sentinel = document.getElementById('load-sentinel');
    const resultCount = document.getElementById('result-count');
    const dateInput = document.getElementById('date-until') as HTMLInputElement | null;
    const tagInput = document.getElementById('tag-input') as HTMLInputElement | null;
    const tagClearBtn = document.getElementById('tag-clear');
    const dropdown = document.getElementById('tag-dropdown');
    const selectedTagsEl = document.getElementById('selected-tags');
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;

    if (list && cardTemplate) {
      const TOTAL = Number(list.getAttribute('data-total') ?? 0);

      // --- URL query string sync ---
      const getParams = () => new URLSearchParams(window.location.search);

      const syncURL = () => {
        const params = new URLSearchParams();
        const q = searchInput?.value.trim() ?? '';
        if (q) params.set('q', q);
        if (activeTags.size > 0) params.set('tags', Array.from(activeTags).join(','));
        const d = dateInput?.value ?? '';
        if (d) params.set('date', d);
        const qs = params.toString();
        history.replaceState(null, '', window.location.pathname + (qs ? `?${qs}` : ''));
      };

      // Read initial state from URL
      const initParams = getParams();
      const activeTags = new Set<string>(
        initParams.get('tags')?.split(',').filter(Boolean) ?? []
      );
      let visibleCount = PAGE_SIZE;
      let searchMatchIds: Set<string> | null = null;
      // コーパスが後から届いても同じクエリのまま描き直せるように進める世代番号
      let dataVersion = 0;

      // Restore date input
      if (dateInput && initParams.get('date')) {
        dateInput.value = initParams.get('date')!;
      }
      // Restore search input
      if (searchInput && initParams.get('q')) {
        searchInput.value = initParams.get('q')!;
      }

      // --- 一覧メタデータ（全件）の遅延ロード ---
      // 初回の HTML には1ページ目しか入っていない。2ページ目以降を出すときと、
      // 全件を対象にした絞り込みを掛けるときに、ここで初めて取りに行く。
      let entries: Entry[] | null = null;
      let indexFailed = false;
      let indexPromise: Promise<void> | null = null;

      const loadIndex = (): Promise<void> => {
        if (indexPromise) return indexPromise;

        indexPromise = (async () => {
          try {
            const parts = await Promise.all(PARTS.map(async (part) => {
              const res = await fetch(`${BASE_URL}/reports-index/${part}.json`);
              if (!res.ok) throw new Error(String(res.status));
              return (await res.json()) as Entry[];
            }));
            // 一部だけ表示するとレポートが黙って消えたように見えるので、揃わなければ諦める。
            // part をまたぐぶん、結合してから日付の新しい順に揃え直す
            entries = parts.flat().sort((a, b) => (a[3] < b[3] ? 1 : a[3] > b[3] ? -1 : 0));
          } catch {
            indexFailed = true;
          }
          refreshTagOptions();
          render();
        })();

        return indexPromise;
      };

      // --- Full-text search (zstd 圧縮したコーパスを遅延ロードして部分一致) ---
      // 形態素解析や n-gram では分割の都合で取りこぼしや誤検出が出るため、
      // 本文そのものを配って線形に走査する。1600件・946万文字で1クエリ 1-2ms。
      // コーパスは archive（月に一度しか変わらない）と current（当月ぶん）の2ファイル。
      const corpus: Array<[string, string]> = [];
      let corpusLoading = false;
      let corpusMissing = 0;
      let corpusPromise: Promise<void> | null = null;

      const loadCorpus = (): Promise<void> => {
        if (corpusPromise) return corpusPromise;
        corpusLoading = true;

        corpusPromise = (async () => {
          // zstd 復元器は検索が使われたときだけ読み込む。
          // コーパスの取得と並行させたいので、待つのは復元が要るところまで遅らせる
          const decoderReady = (async () => {
            const { ZSTDDecoder } = await import('zstddec');
            const decoder = new ZSTDDecoder();
            await decoder.init();
            return decoder;
          })();
          let ok = 0;

          await Promise.all(PARTS.map(async (part) => {
            try {
              const res = await fetch(`${BASE_URL}/search-corpus/${part}.zst`);
              if (!res.ok) throw new Error(String(res.status));
              const decoder = await decoderReady;
              // 展開後のサイズは zstd のフレームヘッダから読まれる
              const raw = decoder.decode(new Uint8Array(await res.arrayBuffer()));
              for (const doc of JSON.parse(new TextDecoder().decode(raw)) as Array<[string, string]>) {
                corpus.push(doc);
              }
              ok++;
            } catch {
              // 片方が落ちても、取れたぶんだけで検索を続ける
            }
            // 届いたぶんを先に結果へ反映する（小さい current が先に着く）
            if (searchInput?.value.trim()) {
              runSearch();
              render();
            }
          }));

          corpusLoading = false;
          corpusMissing = PARTS.length - ok;
          // 読み込み状態が変わったので、注記を出し直すために描き直す
          render();
        })();

        return corpusPromise;
      };

      // 英数字だけの語は語境界で照合する（"ai" が "said" に当たらないように）。
      // 日本語を含む語は語境界の概念がないので単純な部分一致にする。
      const LATIN_ONLY = /^[0-9a-zÀ-ɏ]+$/;
      const buildMatchers = (query: string): Array<(text: string) => boolean> =>
        query.split(/\s+/).filter(Boolean).map((term) => {
          if (!LATIN_ONLY.test(term)) return (text: string) => text.includes(term);
          const pattern = new RegExp(`\\b${term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\b`);
          return (text: string) => pattern.test(text);
        });

      // 空白区切りの語をすべて含むレポートに絞り込む（AND）
      const runSearch = () => {
        const query = normalizeForSearch(searchInput?.value.trim() ?? '');
        const matchers = query ? buildMatchers(query) : [];
        if (matchers.length === 0) {
          searchMatchIds = null;
          dataVersion++;
          return;
        }
        const ids = new Set<string>();
        for (const [id, text] of corpus) {
          if (matchers.every((match) => match(text))) ids.add(id);
        }
        searchMatchIds = ids;
        dataVersion++;
      };

      if (searchInput) {
        // Lazy-load on focus
        searchInput.addEventListener('focus', () => { loadCorpus(); loadIndex(); }, { once: true });

        let searchTimer: ReturnType<typeof setTimeout> | null = null;
        searchInput.addEventListener('input', () => {
          if (searchTimer) clearTimeout(searchTimer);
          searchTimer = setTimeout(() => {
            loadCorpus();
            runSearch();
            applyFilters();
          }, 150);
        });

        // If query was restored from URL, load immediately
        if (initParams.get('q')) {
          loadCorpus();
        }
      }

      // --- Tag combobox ---
      // 候補は一覧メタデータが届いてから組み立てる。loadIndex の完了時に呼ばれる
      let refreshTagOptions = () => {};

      if (tagInput && dropdown) {
        const optionTemplate = document.getElementById('tag-option-template') as HTMLTemplateElement | null;
        const options: HTMLElement[] = [];

        const updateDropdown = () => {
          const query = tagInput.value.toLowerCase();
          let anyVisible = false;
          for (const opt of options) {
            const tag = opt.getAttribute('data-tag')!;
            const match = !query || tag.toLowerCase().includes(query);
            opt.style.display = match ? '' : 'none';
            opt.classList.toggle('selected', activeTags.has(tag));
            if (match) anyVisible = true;
          }
          dropdown.classList.toggle('open', anyVisible);
        };

        const renderSelectedTags = () => {
          selectedTagsEl!.innerHTML = '';
          for (const tag of activeTags) {
            const btn = document.createElement('button');
            btn.className = 'inline-flex items-center gap-1 text-[0.7rem] py-0.5 px-2 rounded-full bg-[var(--accent)] text-[var(--bg)] cursor-pointer border-none hover:opacity-80';
            btn.textContent = `${tag} ×`;
            btn.addEventListener('click', () => {
              activeTags.delete(tag);
              renderSelectedTags();
              updateDropdown();
              applyFilters();
            });
            selectedTagsEl!.appendChild(btn);
          }
          tagClearBtn!.classList.toggle('visible', activeTags.size > 0);
        };

        const toggleTag = (tag: string) => {
          if (activeTags.has(tag)) {
            activeTags.delete(tag);
          } else {
            activeTags.add(tag);
          }
          tagInput.value = '';
          updateDropdown();
          renderSelectedTags();
          applyFilters();
        };

        refreshTagOptions = () => {
          if (!entries || !optionTemplate || options.length > 0) return;
          const all = new Set<string>();
          for (const [, , , , category, tags] of entries) {
            all.add(`category:${category}`);
            for (const tag of tags) all.add(tag);
          }
          const frag = document.createDocumentFragment();
          for (const tag of [...all].sort()) {
            const opt = optionTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
            opt.setAttribute('data-tag', tag);
            opt.textContent = tag;
            opt.addEventListener('click', (e) => {
              e.stopPropagation();
              toggleTag(tag);
            });
            frag.appendChild(opt);
            options.push(opt);
          }
          dropdown.appendChild(frag);
          // 候補待ちのあいだに開かれていたら、そのまま開いて見せる
          if (document.activeElement === tagInput) updateDropdown();
        };

        // 候補も絞り込みも全件のメタデータが要るので、開いた時点で取りに行っておく
        tagInput.addEventListener('focus', () => { loadIndex(); updateDropdown(); });
        tagInput.addEventListener('input', () => updateDropdown());

        document.addEventListener('click', (e) => {
          if (!document.getElementById('tag-combo')?.contains(e.target as Node)) {
            dropdown.classList.remove('open');
          }
        });

        tagClearBtn!.addEventListener('click', () => {
          activeTags.clear();
          tagInput.value = '';
          renderSelectedTags();
          updateDropdown();
          applyFilters();
        });

        if (activeTags.size > 0) {
          renderSelectedTags();
        }
      }

      // --- Date filter ---
      if (dateInput) {
        dateInput.addEventListener('focus', () => { loadIndex(); }, { once: true });
        dateInput.addEventListener('change', () => applyFilters());
      }

      // --- カードの組み立て ---
      const iconByCategory = new Map<string, Element>();
      for (const holder of Array.from(iconTemplates?.children ?? [])) {
        const svg = holder.firstElementChild;
        if (svg) iconByCategory.set(holder.getAttribute('data-icon')!, svg);
      }

      // SSR 側と同じ「UTC に9時間足して切り出す」表記に揃える
      const formatJst = (iso: string) =>
        new Date(new Date(iso).getTime() + 9 * 60 * 60 * 1000)
          .toISOString().slice(0, 16).replace('T', ' ') + ' JST';

      const buildCard = ([id, title, summary, date, category, tags]: Entry): Element => {
        const card = cardTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;

        const iconSlot = card.querySelector('.card-icon')!;
        const icon = iconByCategory.get(category);
        if (icon) iconSlot.appendChild(icon.cloneNode(true));
        else iconSlot.remove();

        const link = card.querySelector('.card-link') as HTMLAnchorElement;
        link.href = `${BASE_URL}/reports/${id}/`;
        link.textContent = title;

        const time = card.querySelector('.card-time') as HTMLTimeElement;
        time.dateTime = date;
        time.textContent = formatJst(date);

        card.querySelector('.card-category')!.textContent = category;
        card.querySelector('.card-summary')!.textContent = summary;

        const tagsEl = card.querySelector('.card-tags')!;
        if (tags.length > 0 && tagTemplate) {
          for (const tag of tags) {
            const pill = tagTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
            pill.textContent = tag;
            tagsEl.appendChild(pill);
          }
        } else {
          tagsEl.remove();
        }

        return card;
      };

      // --- Filtering & pagination ---
      const filterEntries = (): Entry[] => {
        const dateVal = dateInput?.value ?? '';
        return entries!.filter(([id, , , date, category, tags]) => {
          if (searchMatchIds && !searchMatchIds.has(id)) return false;
          if (activeTags.size > 0) {
            const cardTags = [`category:${category}`, ...tags];
            if (![...activeTags].some((t) => cardTags.includes(t))) return false;
          }
          if (dateVal && date.slice(0, 10) > dateVal) return false;
          return true;
        });
      };

      const hasFilter = () =>
        Boolean(searchInput?.value.trim()) || activeTags.size > 0 || Boolean(dateInput?.value);

      const applyFilters = () => {
        visibleCount = PAGE_SIZE;
        loadIndex();
        syncURL();
        render();
      };

      const noteForCount = () => {
        if (indexFailed) return '（一覧データの読み込みに失敗しました）';
        if (!entries) return '（読み込み中...）';
        if (!searchInput?.value.trim()) return '';
        if (corpusLoading) return '（過去ぶんを読み込み中...）';
        if (corpusMissing === PARTS.length) return '（検索データの読み込みに失敗しました）';
        if (corpusMissing > 0) return '（一部の検索データを読み込めなかったため、結果が欠けている可能性があります）';
        return '';
      };

      // 同じ絞り込みのまま表示数だけ増えたときは、差分だけ足して積み直しを避ける
      let renderedKey: string | null = null;
      let renderedCount = 0;

      const filterKey = () => JSON.stringify([
        searchInput?.value.trim() ?? '',
        [...activeTags].sort(),
        dateInput?.value ?? '',
        dataVersion,
      ]);

      const render = () => {
        if (!entries) {
          // メタデータ待ち。絞り込みが掛かっているなら、まだ絞れていない1ページ目は出さない
          if (hasFilter()) {
            list.replaceChildren();
            if (sentinel) sentinel.style.display = 'none';
            renderedKey = null;
            renderedCount = 0;
          }
          // 絞り込みも失敗も無い間は、SSR された「N件中 20件表示」をそのまま残す
          if (resultCount && (hasFilter() || indexFailed)) {
            const total = hasFilter() ? 0 : TOTAL;
            const shown = hasFilter() ? 0 : Math.min(PAGE_SIZE, TOTAL);
            resultCount.textContent = `${total}件中 ${shown}件表示${noteForCount()}`;
          }
          return;
        }

        const filtered = filterEntries();
        const key = filterKey();
        const shown = Math.min(visibleCount, filtered.length);

        if (key === renderedKey && shown >= renderedCount) {
          for (let i = renderedCount; i < shown; i++) list.appendChild(buildCard(filtered[i]));
        } else {
          const frag = document.createDocumentFragment();
          for (let i = 0; i < shown; i++) frag.appendChild(buildCard(filtered[i]));
          list.replaceChildren(frag);
        }
        renderedKey = key;
        renderedCount = shown;

        if (resultCount) {
          resultCount.textContent = `${filtered.length}件中 ${shown}件表示${noteForCount()}`;
        }
        if (sentinel) {
          sentinel.style.display = visibleCount < filtered.length ? '' : 'none';
        }
        // 絞り込みの変更などで表示が減ったときも、画面が埋まるまで継ぎ足す
        scheduleFill();
      };

      // --- Infinite scroll ---
      // 続きが残っている間、番兵が視界（＋先読みマージン）に入ったら次のページを出す。
      // 出したあとも番兵が視界に残っていることがある（画面が高い・1ページが短い）ので、
      // IntersectionObserver の再通知を待たずに rAF で埋まるまで繰り返す。
      const LOAD_MARGIN = 600;
      let fillScheduled = false;

      const fillViewport = () => {
        if (!sentinel || sentinel.style.display === 'none') return;
        if (sentinel.getBoundingClientRect().top > window.innerHeight + LOAD_MARGIN) return;
        // 2ページ目からはメタデータが要る。届いたら loadIndex 側が描き直す。
        // 取得中に何度も呼ばれるので、ページを進めるのは最初の1回だけ
        if (!entries) {
          if (indexFailed) return;
          if (!indexPromise) visibleCount += PAGE_SIZE;
          loadIndex();
          return;
        }
        visibleCount += PAGE_SIZE;
        render();
      };

      const scheduleFill = () => {
        if (fillScheduled) return;
        fillScheduled = true;
        requestAnimationFrame(() => {
          fillScheduled = false;
          fillViewport();
        });
      };

      if (sentinel && typeof IntersectionObserver !== 'undefined') {
        new IntersectionObserver(
          (records) => {
            if (records.some((r) => r.isIntersecting)) fillViewport();
          },
          { rootMargin: `${LOAD_MARGIN}px 0px` },
        ).observe(sentinel);
      } else {
        // IntersectionObserver が無い環境向けのフォールバック
        window.addEventListener('scroll', scheduleFill, { passive: true });
        window.addEventListener('resize', scheduleFill, { passive: true });
      }

      // URL から絞り込みが復元された場合だけ、初回にメタデータを取りに行く。
      // 何も指定が無ければ SSR された1ページ目をそのまま使い、通信もDOM操作もしない
      if (hasFilter()) {
        loadIndex();
        render();
      }
    }
  </script>
</Layout>
