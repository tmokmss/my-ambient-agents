---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { FileText, Search, AlertTriangle, Flame } from "@lucide/astro";

const reports = (await getCollection("reports")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const categoryIcons: Record<string, any> = { summary: FileText, analysis: Search, alert: AlertTriangle, buzz: Flame };

const allTags = [...new Set(reports.flatMap((r) => [`category:${r.data.category}`, ...(r.data.tags ?? [])]))].sort();
const PAGE_SIZE = 20;
---

<Layout title="Reports">
  <div class="flex flex-wrap gap-3 mb-6 items-start">
    <div class="flex-1 min-w-[200px] max-sm:min-w-0">
      <input type="search" id="search-input" placeholder="全文検索..." autocomplete="off" class="w-full h-9 px-3 text-[0.8rem] border border-[var(--border)] rounded-lg bg-[var(--card-bg)] text-[var(--fg)] outline-none transition-[border-color] duration-150 focus:border-[var(--accent)] placeholder:text-[var(--muted)]" />
    </div>
    {allTags.length > 0 && (
      <div class="relative min-w-[200px] flex-1 max-w-xs max-sm:min-w-0 max-sm:max-w-none" id="tag-combo">
        <div class="relative flex items-center">
          <input class="w-full h-9 pr-8 pl-3 text-[0.8rem] border border-[var(--border)] rounded-lg bg-[var(--card-bg)] text-[var(--fg)] outline-none focus:border-[var(--accent)] placeholder:text-[var(--muted)]" id="tag-input" type="text" placeholder="タグで絞り込み..." autocomplete="off" />
          <button class="tag-clear absolute right-1.5 items-center justify-center w-5 h-5 border-none rounded-full bg-[var(--muted)] text-[var(--bg)] text-[0.7rem] leading-none cursor-pointer p-0 hover:bg-[var(--fg)]" id="tag-clear" aria-label="タグをクリア">&times;</button>
        </div>
        <ul class="tag-dropdown absolute top-full left-0 right-0 max-h-[200px] overflow-y-auto bg-[var(--card-bg)] border border-[var(--border)] border-t-0 rounded-b-lg z-10 list-none" id="tag-dropdown">
          {allTags.map((tag) => (
            <li class="tag-option px-3 py-1.5 text-[0.8rem] cursor-pointer text-[var(--fg)] hover:bg-[var(--code-bg)]" data-tag={tag}>{tag}</li>
          ))}
        </ul>
      </div>
    )}
    <div class="flex items-center gap-2 max-sm:[&_label]:hidden max-sm:[&_.date-input]:w-full">
      <label for="date-until" class="text-[0.8rem] text-[var(--muted)] whitespace-nowrap">表示期間:</label>
      <input class="date-input h-9 px-3 text-[0.8rem] font-[inherit] border border-[var(--border)] rounded-lg bg-[var(--card-bg)] text-[var(--fg)] outline-none focus:border-[var(--accent)]" id="date-until" type="date" />
    </div>
  </div>
  <div class="flex flex-wrap gap-1.5 mb-4 empty:hidden" id="selected-tags"></div>

  {reports.length === 0 ? (
    <p class="text-[var(--muted)]">No reports yet. The agent will generate the first report on its next scheduled run.</p>
  ) : (
    <>
      <p class="text-[0.8rem] text-[var(--muted)] mb-4" id="result-count"></p>
      <ul class="list-none flex flex-col gap-4" id="report-list">
        {reports.map((report) => (
          <li class="report-card px-5 py-4 bg-[var(--card-bg)] border border-[var(--border)] rounded-lg flex gap-4 items-start" data-id={report.id} data-tags={JSON.stringify([`category:${report.data.category}`, ...(report.data.tags ?? [])])} data-date={new Date(report.data.date).toISOString().slice(0, 10)}>
            {() => {
              const Icon = categoryIcons[report.data.category];
              return Icon ? <span class="shrink-0 text-[var(--muted)] mt-0.5 [&_svg]:w-[18px] [&_svg]:h-[18px]"><Icon size={18} /></span> : null;
            }}
            <div class="min-w-0">
              <h2 class="text-base font-semibold mb-1"><a class="report-title" href={`${import.meta.env.BASE_URL}/reports/${report.id}/`}>{report.data.title}</a></h2>
              <div class="text-[0.8rem] text-[var(--muted)]">
                <time class="local-time" datetime={new Date(report.data.date).toISOString()}>{new Date(new Date(report.data.date).getTime() + 9 * 60 * 60 * 1000).toISOString().slice(0, 16).replace('T', ' ')} JST</time> &middot;
                <span>{report.data.category}</span>
              </div>
              <p class="report-summary text-sm mt-2">{report.data.summary}</p>
              {(report.data.tags ?? []).length > 0 && (
                <div class="flex flex-wrap gap-1 mt-2">
                  {(report.data.tags ?? []).map((tag) => (
                    <span class="text-[0.7rem] px-2 py-0.5 rounded-full bg-[var(--code-bg)] text-[var(--muted)]">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </li>
        ))}
      </ul>
      <div class="text-center mt-6" id="load-more-wrap">
        <button class="px-6 py-2 text-[0.85rem] border border-[var(--border)] rounded-lg bg-[var(--card-bg)] text-[var(--fg)] cursor-pointer transition-[border-color] duration-150 hover:border-[var(--accent)] hover:text-[var(--accent)]" id="load-more">もっと表示</button>
      </div>
    </>
  )}

  <script>
    import { CORPUS_PARTS, normalizeForSearch, type SearchDoc } from '../lib/search-text';

    const PAGE_SIZE = 20;
    const BASE_URL = import.meta.env.BASE_URL;

    const allCards = Array.from(document.querySelectorAll<HTMLElement>('#report-list .report-card'));
    const loadMoreBtn = document.getElementById('load-more');
    const loadMoreWrap = document.getElementById('load-more-wrap');
    const resultCount = document.getElementById('result-count');
    const dateInput = document.getElementById('date-until') as HTMLInputElement | null;
    const tagInput = document.getElementById('tag-input') as HTMLInputElement | null;
    const tagClearBtn = document.getElementById('tag-clear');
    const dropdown = document.getElementById('tag-dropdown');
    const selectedTagsEl = document.getElementById('selected-tags');
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;

    if (allCards.length) {
      // --- URL query string sync ---
      const getParams = () => new URLSearchParams(window.location.search);

      const syncURL = () => {
        const params = new URLSearchParams();
        const q = searchInput?.value.trim() ?? '';
        if (q) params.set('q', q);
        if (activeTags.size > 0) params.set('tags', Array.from(activeTags).join(','));
        const d = dateInput?.value ?? '';
        if (d) params.set('date', d);
        const qs = params.toString();
        history.replaceState(null, '', window.location.pathname + (qs ? `?${qs}` : ''));
      };

      // Read initial state from URL
      const initParams = getParams();
      const activeTags = new Set<string>(
        initParams.get('tags')?.split(',').filter(Boolean) ?? []
      );
      let visibleCount = PAGE_SIZE;
      let searchMatchIds: Set<string> | null = null;

      // Restore date input
      if (dateInput && initParams.get('date')) {
        dateInput.value = initParams.get('date')!;
      }
      // Restore search input（コーパス読み込み前に全件表示してしまうのを防ぐ）
      if (searchInput && initParams.get('q')) {
        searchInput.value = initParams.get('q')!;
        searchMatchIds = new Set();
      }

      // --- Full-text search (zstd 圧縮したコーパスを遅延ロードして部分一致) ---
      // 形態素解析や n-gram では分割の都合で取りこぼしや誤検出が出るため、
      // 本文そのものを配って線形に走査する。1600件・946万文字で1クエリ 1-3ms。
      // コーパスは archive（月に一度しか変わらない）と current（当月ぶん）の2ファイル。
      // id -> [head（タイトル・概要・タグ）, body（本文）]
      const corpus = new Map<string, [head: string, body: string]>();
      let corpusLoading = false;
      let corpusMissing = 0;
      let corpusPromise: Promise<void> | null = null;

      const loadCorpus = (): Promise<void> => {
        if (corpusPromise) return corpusPromise;
        corpusLoading = true;

        corpusPromise = (async () => {
          // zstd 復元器は検索が使われたときだけ読み込む。
          // コーパスの取得と並行させたいので、待つのは復元が要るところまで遅らせる
          const decoderReady = (async () => {
            const { ZSTDDecoder } = await import('zstddec');
            const decoder = new ZSTDDecoder();
            await decoder.init();
            return decoder;
          })();
          let ok = 0;

          await Promise.all(CORPUS_PARTS.map(async (part) => {
            try {
              const res = await fetch(`${BASE_URL}/search-corpus/${part}.zst`);
              if (!res.ok) throw new Error(String(res.status));
              const decoder = await decoderReady;
              // 展開後のサイズは zstd のフレームヘッダから読まれる
              const raw = decoder.decode(new Uint8Array(await res.arrayBuffer()));
              for (const [id, head, body] of JSON.parse(new TextDecoder().decode(raw)) as SearchDoc[]) {
                corpus.set(id, [head, body]);
              }
              ok++;
            } catch {
              // 片方が落ちても、取れたぶんだけで検索を続ける
            }
            // 届いたぶんを先に結果へ反映する（小さい current が先に着く）
            if (searchInput?.value.trim()) {
              runSearch();
              render();
            }
          }));

          corpusLoading = false;
          corpusMissing = CORPUS_PARTS.length - ok;
          // 読み込み状態が変わったので、注記を出し直すために描き直す
          render();
        })();

        return corpusPromise;
      };

      // 英数字だけの語は語境界で照合する（"ai" が "said" に当たらないように）。
      // 日本語を含む語は語境界の概念がないので単純な部分一致にする。
      // コーパスは原文の大小文字のまま配っている（ヒット箇所をそのまま見せるため）ので、
      // 大小文字は i フラグで畳む。実測で includes 方式との差は1クエリ 1ms 以内。
      const LATIN_ONLY = /^[0-9A-Za-zÀ-ɏ]+$/;
      const buildMatchers = (query: string): RegExp[] =>
        query.split(/\s+/).filter(Boolean).map((term) => {
          const escaped = term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
          return new RegExp(LATIN_ONLY.test(term) ? `\\b${escaped}\\b` : escaped, 'gi');
        });

      // g フラグ付きの正規表現は lastIndex を持ち回るので、使う前に必ず巻き戻す
      const hasMatch = (re: RegExp, text: string): boolean => {
        re.lastIndex = 0;
        return re.test(text);
      };

      /** text 中で語がヒットする位置 [start, end) を、先頭から最大 limit 個 */
      const findHits = (re: RegExp, text: string, limit: number): Array<[number, number]> => {
        re.lastIndex = 0;
        const hits: Array<[number, number]> = [];
        let m: RegExpExecArray | null;
        while (hits.length < limit && (m = re.exec(text)) !== null) {
          hits.push([m.index, m.index + m[0].length]);
        }
        return hits;
      };

      // 現在のクエリの語。絞り込みとハイライトの両方がこれを見る
      let searchMatchers: RegExp[] = [];

      // 空白区切りの語をすべて含むレポートに絞り込む（AND）。
      // 語ごとに head か body のどちらかに出ていればよい
      const runSearch = () => {
        const query = normalizeForSearch(searchInput?.value.trim() ?? '');
        searchMatchers = query ? buildMatchers(query) : [];
        if (searchMatchers.length === 0) {
          searchMatchIds = null;
          return;
        }
        const ids = new Set<string>();
        for (const [id, [head, body]] of corpus) {
          if (searchMatchers.every((re) => hasMatch(re, head) || hasMatch(re, body))) ids.add(id);
        }
        searchMatchIds = ids;
      };

      if (searchInput) {
        // Lazy-load on focus
        searchInput.addEventListener('focus', () => { loadCorpus(); }, { once: true });

        let searchTimer: ReturnType<typeof setTimeout> | null = null;
        searchInput.addEventListener('input', () => {
          if (searchTimer) clearTimeout(searchTimer);
          searchTimer = setTimeout(() => {
            loadCorpus();
            runSearch();
            applyFilters();
          }, 150);
        });

        // If query was restored from URL, load immediately
        if (initParams.get('q')) {
          loadCorpus();
        }
      }

      // --- Tag combobox ---
      if (tagInput && dropdown) {
        const options = Array.from(dropdown.querySelectorAll<HTMLElement>('.tag-option'));

        const updateDropdown = () => {
          const query = tagInput.value.toLowerCase();
          let anyVisible = false;
          for (const opt of options) {
            const tag = opt.getAttribute('data-tag')!;
            const match = !query || tag.toLowerCase().includes(query);
            opt.style.display = match ? '' : 'none';
            opt.classList.toggle('selected', activeTags.has(tag));
            if (match) anyVisible = true;
          }
          dropdown.classList.toggle('open', anyVisible);
        };

        const renderSelectedTags = () => {
          selectedTagsEl!.innerHTML = '';
          for (const tag of activeTags) {
            const btn = document.createElement('button');
            btn.className = 'inline-flex items-center gap-1 text-[0.7rem] py-0.5 px-2 rounded-full bg-[var(--accent)] text-[var(--bg)] cursor-pointer border-none hover:opacity-80';
            btn.textContent = `${tag} \u00d7`;
            btn.addEventListener('click', () => {
              activeTags.delete(tag);
              renderSelectedTags();
              updateDropdown();
              applyFilters();
            });
            selectedTagsEl!.appendChild(btn);
          }
          tagClearBtn!.classList.toggle('visible', activeTags.size > 0);
        };

        tagInput.addEventListener('focus', () => updateDropdown());
        tagInput.addEventListener('input', () => updateDropdown());

        document.addEventListener('click', (e) => {
          if (!document.getElementById('tag-combo')?.contains(e.target as Node)) {
            dropdown.classList.remove('open');
          }
        });

        for (const opt of options) {
          opt.addEventListener('click', (e) => {
            e.stopPropagation();
            const tag = opt.getAttribute('data-tag')!;
            if (activeTags.has(tag)) {
              activeTags.delete(tag);
            } else {
              activeTags.add(tag);
            }
            tagInput.value = '';
            updateDropdown();
            renderSelectedTags();
            applyFilters();
          });
        }

        tagClearBtn!.addEventListener('click', () => {
          activeTags.clear();
          tagInput.value = '';
          renderSelectedTags();
          updateDropdown();
          applyFilters();
        });

        if (activeTags.size > 0) {
          renderSelectedTags();
        }
      }

      // --- Date filter ---
      if (dateInput) {
        dateInput.addEventListener('change', () => applyFilters());
      }

      // --- ヒット箇所の表示 ---
      // タイトル・概要は見えているものをそのままハイライトし、
      // 本文はヒット位置の前後を切り出して見せる（どこに当たったか分かるように）。
      const SNIPPET_BEFORE = 30;  // ヒット位置の手前に見せる文字数
      const SNIPPET_AFTER = 90;   // ヒット位置から後ろに見せる文字数
      const MAX_SNIPPETS = 2;     // 1件あたりに出す抜粋の数
      const MAX_MARKS = 20;       // 抜粋1つの中で色を付ける上限（同じ語の連打で膨らませない）

      /** text を、語の部分だけ <mark> で包んだノード列にする */
      const highlight = (text: string, matchers: RegExp[]): DocumentFragment => {
        const hits: Array<[number, number]> = [];
        for (const re of matchers) hits.push(...findHits(re, text, MAX_MARKS));
        hits.sort((a, b) => a[0] - b[0]);

        const frag = document.createDocumentFragment();
        let cursor = 0;
        for (const [start, end] of hits) {
          if (start < cursor) continue; // 語同士が重なったときは先に出たほうを優先する
          frag.append(text.slice(cursor, start));
          const mark = document.createElement('mark');
          mark.className = 'search-hit';
          mark.textContent = text.slice(start, end);
          frag.append(mark);
          cursor = end;
        }
        frag.append(text.slice(cursor));
        return frag;
      };

      /** 語ごとの最初のヒットから、重ならない抜粋の窓を最大 MAX_SNIPPETS 個作る */
      const snippetWindows = (body: string, matchers: RegExp[]): Array<[number, number]> => {
        const anchors = matchers
          .map((re) => findHits(re, body, 1)[0])
          .filter((hit): hit is [number, number] => hit !== undefined)
          .sort((a, b) => a[0] - b[0]);

        const windows: Array<[number, number]> = [];
        for (const [start] of anchors) {
          const last = windows[windows.length - 1];
          if (last && start < last[1]) continue; // 直前の窓に入っているなら足さない
          if (windows.length >= MAX_SNIPPETS) break;
          windows.push([
            Math.max(0, start - SNIPPET_BEFORE),
            Math.min(body.length, start + SNIPPET_AFTER),
          ]);
        }
        return windows;
      };

      // ハイライトで書き換える前の原文。クエリが変わるたびにここから描き直す
      const pristineText = new WeakMap<HTMLElement, string>();

      const paintText = (el: HTMLElement | null, matchers: RegExp[]) => {
        if (!el) return;
        let text = pristineText.get(el);
        if (text === undefined) {
          text = el.textContent ?? '';
          pristineText.set(el, text);
        }
        if (matchers.length === 0) {
          el.textContent = text;
          return;
        }
        el.replaceChildren(highlight(text, matchers));
      };

      // 直前の描画でハイライトを入れたカード。表示から外れたぶんを消して回るために覚えておく
      const paintedCards = new Set<HTMLElement>();

      /** matchers が空ならハイライトを剥がす。カード1枚ぶんの描き直し */
      const paintCard = (card: HTMLElement, matchers: RegExp[]) => {
        if (matchers.length === 0) paintedCards.delete(card);
        else paintedCards.add(card);

        paintText(card.querySelector<HTMLElement>('.report-title'), matchers);
        paintText(card.querySelector<HTMLElement>('.report-summary'), matchers);

        const body = matchers.length ? corpus.get(card.dataset.id!)?.[1] : undefined;
        const windows = body ? snippetWindows(body, matchers) : [];
        let el = card.querySelector<HTMLElement>('.search-snippet');
        if (windows.length === 0) {
          el?.remove(); // 本文に当たっていない（タイトル・概要だけのヒット）
          return;
        }
        if (!el) {
          el = document.createElement('div');
          el.className = 'search-snippet flex flex-col gap-1 mt-2 pl-3 border-l-2 border-[var(--border)] text-[0.8rem] text-[var(--muted)]';
          card.querySelector('.report-summary')!.after(el);
        }
        el.replaceChildren(...windows.map(([from, to]) => {
          const line = document.createElement('p');
          if (from > 0) line.append('…');
          line.append(highlight(body!.slice(from, to), matchers));
          if (to < body!.length) line.append('…');
          return line;
        }));
      };

      // --- Filtering & pagination ---
      const getFilteredCards = () => {
        const dateVal = dateInput?.value ?? '';
        return allCards.filter(card => {
          if (searchMatchIds) {
            if (!searchMatchIds.has(card.getAttribute('data-id')!)) return false;
          }
          if (activeTags.size > 0) {
            const cardTags: string[] = JSON.parse(card.getAttribute('data-tags') || '[]');
            if (![...activeTags].some(t => cardTags.includes(t))) return false;
          }
          if (dateVal) {
            if (card.getAttribute('data-date')! > dateVal) return false;
          }
          return true;
        });
      };

      const applyFilters = () => {
        visibleCount = PAGE_SIZE;
        syncURL();
        render();
      };

      const render = () => {
        const filtered = getFilteredCards();
        for (const c of allCards) c.style.display = 'none';
        // ハイライトは出すぶんだけ描き、表示から外れたカードからは剥がす
        const stale = new Set(paintedCards);
        for (let i = 0; i < filtered.length && i < visibleCount; i++) {
          filtered[i].style.display = '';
          paintCard(filtered[i], searchMatchers);
          stale.delete(filtered[i]);
        }
        for (const card of stale) paintCard(card, []);
        if (resultCount) {
          const total = filtered.length;
          const shown = Math.min(visibleCount, total);
          let note = '';
          if (searchInput?.value.trim()) {
            if (corpusLoading) note = '（過去ぶんを読み込み中...）';
            else if (corpusMissing === CORPUS_PARTS.length) note = '（検索データの読み込みに失敗しました）';
            else if (corpusMissing > 0) note = '（一部の検索データを読み込めなかったため、結果が欠けている可能性があります）';
          }
          resultCount.textContent = `${total}件中 ${shown}件表示${note}`;
        }
        if (loadMoreWrap) {
          loadMoreWrap.style.display = visibleCount < filtered.length ? '' : 'none';
        }
      };

      // --- Load more ---
      if (loadMoreBtn) {
        loadMoreBtn.addEventListener('click', () => {
          visibleCount += PAGE_SIZE;
          render();
        });
      }

      // Initial render
      render();
    }
  </script>
</Layout>
